{
  "id": "supplied-match-considered-extra-loadable-locale",
  "description": "A fabrication that considers en, fr and de while only en and fr are loaded -- a superset rather than a subset, where de is an ordinary well-formed language the instance simply does not have.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "localeMatchSupplier": {
    "behavior": "fabricated",
    "locale": "fr",
    "matchType": "EXACT",
    "range": "fr",
    "weight": 1,
    "ranges": [
      {
        "range": "fr",
        "weight": 1
      }
    ],
    "fallbackLocale": "en",
    "consideredLocales": [
      "en",
      "fr",
      "de"
    ]
  },
  "files": {
    "fr": {
      "Locale.Marker": "fr",
      "Greeting.Hello": "Bonjour",
      "Only.Fr": "fr-only"
    },
    "en": {
      "Locale.Marker": "en",
      "Greeting.Hello": "Hello",
      "Only.En": "en-only"
    }
  }
}
