{
  "id": "phonetic-resolver-structure",
  "description": "How many times, in what order and for which placeholders the resolver runs inside ONE lookup. Keys cover: two phonetic placeholders over two sources (control, template order == definition order); the SAME two definitions with the template mentioning them in the OPPOSITE order and reading DIFFERENT sources, so resolverCalls order actually discriminates template order from definition order; two differently-named placeholders reading one source (no memoization); one placeholder referenced twice in a template (resolved once); a phonetic definition the template never references; an alternative that shadows the top-level placeholder; a phonetic branch whose text names a second phonetic placeholder, so the second call happens only because the first selected that branch; a first placeholder whose selected constant has no branch; and a definition mixing a tagged value with a raw term.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "phoneticResolver": {
    "behavior": "by-term",
    "mapping": {
      "apple": "PHONETIC_VOWEL",
      "book": "PHONETIC_CONSONANT",
      "strange": "PHONETIC_S_IMPURE"
    },
    "default": "PHONETIC_OTHER"
  },
