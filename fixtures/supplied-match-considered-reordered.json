{
  "id": "supplied-match-considered-reordered",
  "description": "A fabrication whose considered locales are the loaded ones in REVERSE of the instance's own sorted order (fr before en). The instance validation compares sets, so this is accepted, and the result must then report the caller's order rather than the library's.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "localeMatchSupplier": {
    "behavior": "fabricated",
    "locale": "fr",
    "matchType": "EXACT",
    "range": "fr",
    "weight": 1,
    "ranges": [
      {
        "range": "fr",
        "weight": 1
      }
    ],
    "fallbackLocale": "en",
    "consideredLocales": [
      "fr",
      "en"
    ]
  },
  "files": {
    "fr": {
      "Locale.Marker": "fr",
      "Greeting.Hello": "Bonjour",
      "Only.Fr": "fr-only"
    },
    "en": {
      "Locale.Marker": "en",
      "Greeting.Hello": "Hello",
      "Only.En": "en-only"
    }
  }
}
