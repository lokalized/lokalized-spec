{
  "id": "owed-loader-bounded-diagnostics",
  "description": "Two files whose duplicate-JSON-member diagnostics exceed the loader's own bounds. `en` has a 4092-character top-level key, so the JSON path reaches 4094 characters and the next member name lands with exactly ONE character of room -- the single-ellipsis tail -- and the duplicate below it is reported at an already-saturated path. `fr` has a 5000-character key (truncated with room to spare) whose value repeats a 300-character member name, so the reported member is cut to 255 characters plus U+2026. Verbatim text: JSON.stringify cannot emit a duplicate member.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "loadOnly": true,
  "files": {},
  "rawFiles": {
    "en": "{\"\":{\"ab\":{\"x\":1,\"x\":2}}}",
    "fr": "{\"\":{\"translation\":\"t\",\"\":1,\"\":2}}"
  }
}
