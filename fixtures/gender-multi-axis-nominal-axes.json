{
  "id": "gender-multi-axis-nominal-axes",
  "description": "Plan v7 section 8.3 multi-axis dispatch for the axes that have NO numeric fallback: grammatical-case, definiteness, classifier, formality, clusivity, animacy and phonetic each get a dispatching definition, so every one of the ten arms of the language-form branch in DefaultStrings.getInternal is exercised by some case in this family. Invitation.Message dispatches on three axes at once (formality, gender, cardinality). Arrival.Announcement's alternatives select on formality while its inherited placeholders select on definiteness and animacy. Section 3.7 says these selectors REQUIRE the expected tagged axis, so the fixture also carries the maps a wrong-axis, raw-string, or numeric value is fed into; each rejection uses a DIFFERENT key so the RETURNED_KEY translations stay distinguishable. The classifier map deliberately omits CLASSIFIER_PERSON so the absent-form path is reachable. Only the tagged-Phonetic input path is used: a CharSequence phonetic input would route through PhoneticResolver, which is outside the oracle's scope. Tiebreakers are null: only 'en' is loaded.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "files": {
    "en": {
      "Gift.Recipient": {
        "translation": "I gave the book to {{recipientForm}}.",
        "placeholders": {
          "recipientForm": {
            "value": "grammaticalCase",
            "translations": {
              "CASE_NOMINATIVE": "Ivan",
              "CASE_DATIVE": "Ivanu",
              "CASE_ACCUSATIVE": "Ivana"
            }
          }
        }
      },
      "Document.Open": {
        "translation": "Open {{documentForm}}.",
        "placeholders": {
          "documentForm": {
            "value": "definiteness",
            "translations": {
              "DEFINITENESS_DEFINITE": "the book",
              "DEFINITENESS_INDEFINITE": "a book",
              "DEFINITENESS_CONSTRUCT": "book of"
            }
          }
        }
      },
      "Items.Bought": {
        "translation": "I bought {{itemCount}} {{counter}}.",
