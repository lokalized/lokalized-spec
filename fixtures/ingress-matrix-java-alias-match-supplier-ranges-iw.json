{
  "id": "ingress-matrix-java-alias-match-supplier-ranges-iw",
  "description": "Alias arm catalog with a localeMatchSupplier negotiating the header 'iw' through the whole-list solver, so the IANA equivalence expansion (iw, he) happens inside the supplier and survives onto the result.",
  "fallbackLocale": "en",
  "tiebreakers": null,
  "localeMatchSupplier": {
    "behavior": "match-ranges",
    "ranges": "iw"
  },
  "files": {
