      "input": {
        "key": "Checkout.Title"
      },
      "partition": "requiredPortableIds",
      "notes": "No per-call locale: the ambient match supplier decides. Its negotiated locale should serve the key and appear as the result's match."
    },
    {
      "id": "ingress-smoke.supplied.per-call-locale-overrides-supplier",
