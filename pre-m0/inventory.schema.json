{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokalized.org/schemas/pre-m0/inventory.schema.json",
  "title": "Lokalized JS pre-M0 normative-block inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "status",
    "sourcePlanSha256",
    "scope",
    "blocks"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "status": {
      "const": "pre-m0-inventory-draft"
    },
    "sourcePlanSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[1-9]|1[0-4])$"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "milestone": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3a",
        "M3b",
        "M4",
        "M5a",
        "M5b",
        "M6",
        "M7",
        "M8",
        "M9",
        "M-D",
        "M-R",
        "M-E",
        "M-X"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lineStart",
        "lineEnd",
        "sourceAnchor",
        "synopsis",
        "disposition",
        "registrationBefore",
        "owner",
        "parityClass",
        "anticipatedAtomicRecords",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INV-[0-9]+-[0-9]+-[0-9]{3}$"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "sourceAnchor": {
          "type": "string",
          "minLength": 1
        },
        "synopsis": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "initial-registration",
            "deferred",
            "nonnormative"
          ]
        },
        "registrationBefore": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "owner": {
          "oneOf": [
            {
              "$ref": "#/$defs/milestone"
            },
            {
              "const": "none"
            }
          ]
        },
        "parityClass": {
          "enum": [
            "portable",
            "implementation-required",
            "informational-nonportable",
            "process-only"
          ]
        },
        "anticipatedAtomicRecords": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
