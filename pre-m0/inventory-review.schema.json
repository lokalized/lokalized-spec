{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokalized.org/schemas/pre-m0/inventory-review.schema.json",
  "title": "Lokalized JS inventory review attestation",
  "description": "Structural schema. pre-m0/validate-artifacts.mjs is the authoritative approval gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "status",
    "sourcePlanSha256",
    "inventoryFiles",
    "counts",
    "agentReviews",
    "approvals",
    "blockingReasons"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["agent-review-in-progress", "agent-reviewed-awaiting-human", "human-approved"] },
    "sourcePlanSha256": { "$ref": "#/$defs/hash" },
    "inventoryFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileBinding" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalBlocks", "anticipatedInitialRecords", "m0FrontierRecords", "m1FrontierRecords", "m2FrontierRecords", "m3aFrontierRecords"],
      "properties": {
        "totalBlocks": { "type": "integer", "minimum": 1 },
        "anticipatedInitialRecords": { "type": "integer", "minimum": 1 },
        "m0FrontierRecords": { "type": "integer", "minimum": 0 },
        "m1FrontierRecords": { "type": "integer", "minimum": 0 },
        "m2FrontierRecords": { "type": "integer", "minimum": 0 },
        "m3aFrontierRecords": { "type": "integer", "minimum": 0 }
      }
    },
    "agentReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "scope", "status"],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanReviewer", "humanDecisionOwner", "approvedAt"],
      "properties": {
        "humanReviewer": { "type": ["string", "null"] },
        "humanDecisionOwner": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] }
      }
    },
    "blockingReasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
